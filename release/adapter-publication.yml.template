# INACTIVE REVIEW TEMPLATE. Do not install under .github/workflows until
# bootstrap, owner-side npm trust/settings verification and exact activation
# receive separate operational review and approval.
# The preparation guard always blocks; activation needs a fresh reviewed change.
name: Publish reviewed adapter
on:
  workflow_dispatch:
    inputs:
      reviewed_source_sha:
        description: Exact owner-reviewed public source commit
        required: true
      reviewed_tarball_sha256:
        description: Exact SHA256 of the reviewed tarball
        required: true
permissions:
  actions: read
  contents: read
jobs:
  release:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    environment: npm-release
    permissions:
      actions: read
      contents: read
      id-token: write
    steps:
      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09
        with:
          persist-credentials: false
      - uses: actions/setup-node@a0853c24544627f65ddf259abe73b1d18a591444
        with:
          node-version: 22.23.2
      - name: Require npm 11.15.0 or newer for trusted publication
        run: |
          npm install --global --ignore-scripts npm@11.15.0
          node -e "const [major,minor]=process.versions.node.split('.').map(Number); if(major<22 || (major===22 && minor<14)) process.exit(1)"
          node -e "const [major,minor]=require('child_process').execFileSync('npm',['--version'],{encoding:'utf8'}).trim().split('.').map(Number); if(major<11 || (major===11 && minor<15)) process.exit(1)"
      - run: npm ci --ignore-scripts
      - run: npm test
      - run: npm run adapter:pack -- --output reviewed-artifact
      - name: Verify reviewed artifact and real GitHub protection; block pending npm setup
        env:
          REVIEWED_SOURCE_SHA: ${{ inputs.reviewed_source_sha }}
          REVIEWED_TARBALL_SHA256: ${{ inputs.reviewed_tarball_sha256 }}
          GITHUB_TOKEN: ${{ github.token }}
        run: node scripts/check-adapter-release.js reviewed-artifact/tech-adventures-llc-intake-site-adapter-1.1.0.tgz
      # The guard requires workflow_dispatch on protected main, both run actors
      # to be the sole owner, exact source/tarball, and actual repository,
      # workflow-run, branch and environment settings. It always blocks at npm
      # owner setup. A separately approved activation must verify package
      # existence, account 2FA and trusted publisher identity/action. New trust
      # defaults to staged publishing; direct publish needs --allow-publish.
      # Only after replacing the terminal guard in a reviewed change may a
      # workflow publish this exact reviewed .tgz with --access public and
      # --provenance. Never publish from a rebuilt directory or move its version.
      # Never replace OIDC with a permanent token or disable provenance.
